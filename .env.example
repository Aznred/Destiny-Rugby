# Secrets réservés aux fonctions serveur. Ne jamais les préfixer par VITE_ :
# Vite rendrait alors leur valeur publique dans le navigateur.
DATABASE_URL=
SEL_APPAREIL=

# ⚠️ CELLE-CI EST PUBLIQUE, ET C'EST ASSUMÉ. `VITE_` = injectée dans le bundle,
# donc lisible par n'importe quel joueur. C'est le prix à payer pour que
# personne n'ait de clé à saisir : tout le monde joue avec celle du site.
# Clé gratuite : https://console.groq.com/keys
VITE_GROQ_KEY=

# Facultatif — la liste des modèles essayés dans l'ordre. Le premier répond,
# et s'il est à court de quota on descend au suivant (les limites Groq sont
# comptées PAR MODÈLE). Laisser vide pour la valeur du jeu.
VITE_GROQ_MODELE=llama-3.3-70b-versatile,llama-3.1-8b-instant

# --- PUBLICITÉ --------------------------------------------------------------
# ⚠️ L'IDENTIFIANT ADSENSE DU SITE EST EN DUR DANS `src/lib/pub.ts`
# (`ca-pub-6166322317354663`, fourni par l'utilisateur). Un `ca-pub-…` est
# public par construction — Google l'exige dans le <script> de chaque page et
# dans `ads.txt` — et le coder en dur évite qu'un déploiement parte sans
# monétisation parce qu'une variable a été oubliée. Cette variable-ci ne sert
# donc qu'à pointer un AUTRE compte (préproduction, test).
VITE_PUB_CLIENT=
# ⚠️ CELLE-CI, EN REVANCHE, RESTE INDISPENSABLE pour voir une vraie annonce.
# Un « slot » se crée bloc par bloc dans la console AdSense (Annonces → Par unité
# d'annonce → créer un bloc display) : personne ne peut le deviner. Tant qu'elle
# est vide, aucune bannière n'est rendue et la pub récompensée de la boutique
# joue son encart MAISON (un compte à rebours du jeu) — jouable et testable,
# mais qui ne rapporte rien à personne. Voir MONETISATION.md.
VITE_PUB_SLOT=
